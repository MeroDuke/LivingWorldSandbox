////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_StaticEquipmentDropTitle ( string EquipmentType, string EquipmentFamily,
                                        integer Tier, integer AffixBonus ) is string
Declare
Begin
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Staff" ) return $LWS_StaticWeaponStaffDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Axeclub" ) return $LWS_StaticWeaponAxeclubDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Dagger" ) return $LWS_StaticWeaponDaggerDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Longsword" ) return $LWS_StaticWeaponLongswordDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Longbow" ) return $LWS_StaticWeaponLongbowDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Crossbow" ) return $LWS_StaticWeaponCrossbowDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Mace" ) return $LWS_StaticWeaponMaceDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Chaos" ) return $LWS_StaticWeaponChaosDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Weapon" && EquipmentFamily == "Hammer" ) return $LWS_StaticWeaponHammerDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Armor" && EquipmentFamily == "Leather" ) return $LWS_StaticArmorLeatherDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Armor" && EquipmentFamily == "Chain" ) return $LWS_StaticArmorChainDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Armor" && EquipmentFamily == "Plate" ) return $LWS_StaticArmorPlateDropTitle ( Tier, AffixBonus );
    if ( EquipmentType == "Armor" && EquipmentFamily == "Chaos" ) return $LWS_StaticArmorChaosDropTitle ( Tier, AffixBonus );
    return "";
End
