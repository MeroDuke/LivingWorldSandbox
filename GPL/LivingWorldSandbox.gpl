////////////////////////////////////////////////////////////////////////////////////////////////////////
// LivingWorldSandbox - minimal quest bootstrap.
// Baseline only: six starter lairs and twenty-four starter monsters.
////////////////////////////////////////////////////////////////////////////////////////////////////////

Function LivingWorldSandbox ()
Declare
    agent Palace;
    list Palaces;
Begin
    Palaces = $ListPalaces ();
    Palace = $ListMember ( Palaces, 1 );

    $LWS_SeedStarterLairs ( Palace );
    $LWS_SeedStarterMonsters ( Palace );
    $LWS_SeedExplorationChests ( Palace );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_SeedExplorationChests ( agent Palace )
Declare
    agent Chest;
    coordinate BoardExtents, PalaceLocation, SpawnLocation;
    integer BoardWidth, BoardHeight, PalaceX, PalaceY;
    integer FarthestX, FarthestY, FarthestDistance, MinimumDistance, MaximumDistance;
    integer AttemptCount, ChestCount, ChestClass, RewardCount;
Begin
    if ( $IsValidGamePiece ( Palace ) == FALSE ) return;

    BoardExtents = $GetBoardExtents ();
    PalaceLocation = $LocationOf ( Palace );
    BoardWidth = $GetX ( BoardExtents );
    BoardHeight = $GetY ( BoardExtents );
    PalaceX = $GetX ( PalaceLocation );
    PalaceY = $GetY ( PalaceLocation );

    FarthestX = PalaceX;
    if (( BoardWidth - PalaceX ) > FarthestX ) FarthestX = BoardWidth - PalaceX;
    FarthestY = PalaceY;
    if (( BoardHeight - PalaceY ) > FarthestY ) FarthestY = BoardHeight - PalaceY;
    FarthestDistance = $Sqrt (( FarthestX * FarthestX ) + ( FarthestY * FarthestY ));
    MinimumDistance = FarthestDistance / 4;
    MaximumDistance = FarthestDistance / 3;

    AttemptCount = 0;
    ChestCount = 0;
    while (( ChestCount < 12 ) && ( AttemptCount < 120 )) do
        begin
            SpawnLocation = $RandomCoord ( Palace, MinimumDistance, MaximumDistance );
            if ( ChestCount < 8 ) ChestClass = 1;
            else ChestClass = 2;
            RewardCount = 1 + $RandomNumber ( 2 );
            Chest = $LWS_SpawnExplorationChest ( Palace, SpawnLocation, ChestClass, RewardCount );
            if ( $IsValidGamePiece ( Chest )) ChestCount += 1;
            AttemptCount += 1;
        end

    $DebugOut ( 911, "LWS EXPLORATION CHESTS SEEDED", ChestCount,
                "DIST", MinimumDistance, MaximumDistance );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_SeedStarterLairs ( agent Palace )
Declare
    agent SpawnedLair;
    coordinate SpawnLocation;
    integer AttemptCount, LairCount, Roll;
Begin
    AttemptCount = 0;
    LairCount = 0;

    // Placement can fail on occupied or unsuitable terrain. Retry, but never loop forever.
    while (( LairCount < 6 ) && ( AttemptCount < 60 )) do
        begin
            SpawnLocation = $RandomCoord ( Palace, 1200, -1 );
            Roll = $RandomNumber ( 4 );

            if ( Roll == 0 )
                SpawnedLair = $SpawnUnit ( Palace, "Goblin_Hovel", SpawnLocation, "MaxHP", #Monster_Player );
            else if ( Roll == 1 )
                SpawnedLair = $SpawnUnit ( Palace, "Goblin_Camp", SpawnLocation, "MaxHP", #Monster_Player );
            else if ( Roll == 2 )
                SpawnedLair = $SpawnUnit ( Palace, "Animal_Den", SpawnLocation, "MaxHP", #Monster_Player );
            else
                SpawnedLair = $SpawnUnit ( Palace, "BrokenSewerMain", SpawnLocation, "MaxHP", #Monster_Player );

            if ( $IsValidGamePiece ( SpawnedLair ))
                LairCount += 1;

            AttemptCount += 1;
        end
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_SeedStarterMonsters ( agent Palace )
Declare
    agent SpawnedMonster;
    coordinate SpawnLocation;
    integer AttemptCount, MonsterCount, Roll;
Begin
    AttemptCount = 0;
    MonsterCount = 0;

    while (( MonsterCount < 24 ) && ( AttemptCount < 120 )) do
        begin
            SpawnLocation = $RandomCoord ( Palace, 900, -1 );
            Roll = $RandomNumber ( 6 );

            // 50% Giant Rat, 33% Skeleton, 17% Goblin Fighter.
            if ( Roll < 3 )
                SpawnedMonster = $SpawnUnit ( Palace, "Giant_Rat", SpawnLocation, #Monster_Player );
            else if ( Roll < 5 )
                SpawnedMonster = $SpawnUnit ( Palace, "Skeleton", SpawnLocation, #Monster_Player );
            else
                SpawnedMonster = $SpawnUnit ( Palace, "Goblin_Fighter", SpawnLocation, #Monster_Player );

            if ( $IsValidGamePiece ( SpawnedMonster ))
                begin
                    $LWS_EnsureMonsterState ( SpawnedMonster );
                    MonsterCount += 1;
                end

            AttemptCount += 1;
        end
End
