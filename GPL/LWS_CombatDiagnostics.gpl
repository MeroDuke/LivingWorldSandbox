////////////////////////////////////////////////////////////////////////////////////////////////////////
// Phase 0 diagnostic hook for the Northern Expansion combat pipeline.
// No production progression, stat growth, perk, or loot behavior belongs in this file.
////////////////////////////////////////////////////////////////////////////////////////////////////////

Function LWSCombatDiagnostic ()
Declare
    agent AIRootAgent, Palace;
    list Palaces;
Begin
    // Keep the known-good production bootstrap in the diagnostic quest.
    $LivingWorldSandbox ();

    Palaces = $ListPalaces ();
    Palace = $ListMember ( Palaces, 1 );
    AIRootAgent = $RetrieveAgent ( "GplAIRoot" );

    $AddAttribute ( AIRootAgent, "LWS_DiagnosticPassed", "boolean", FALSE );
    $AddAttribute ( AIRootAgent, "LWS_DiagnosticFailures", "integer", 0 );

    // This is a short deterministic integration check, so run it synchronously.
    // Majesty threads must be started through an agent function attribute; passing
    // a bare function to NewThread compiles but does not execute reliably at runtime.
    $LWS_RunCombatDiagnostic ( AIRootAgent, Palace );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_PrepareClassShowcase ( agent Monster, integer ExpectedClass, integer KillCredits ) is boolean
Declare
    integer CreditCount;
Begin
    if ( $IsValidGamePiece ( Monster ) == FALSE )
        return FALSE;

    $LWS_EnsureMonsterState ( Monster );
    if ( Monster's "LWS_ProgressClass" != ExpectedClass )
        return FALSE;

    CreditCount = 0;
    while ( CreditCount < KillCredits ) do
        begin
            $LWS_RecordUnitKill ( Monster );
            CreditCount += 1;
        end

    if ( Monster's "LWS_Level" != 2 )
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_ExperienceLevel ) != 2 )
        return FALSE;
    return TRUE;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_RunCombatDiagnostic ( agent AIRootAgent, agent Palace )
Declare
    agent Attacker, EnemyTarget, FriendlyTarget, LairTarget, BuildingTarget, ArenaPeasant, ShowcaseMonster;
    coordinate TestLocation;
    integer OriginalStrength, PeasantCount;
Begin
    TestLocation = $RandomCoord ( Palace, 300, 500 );
    Attacker = $SpawnUnit ( Palace, "Giant_Rat", TestLocation, #Monster_Player );
    $LWS_EnsureMonsterState ( Attacker );
    $AddAttribute ( Attacker, "LWS_DiagnosticKills", "integer", 0 );
    $AddAttribute ( Attacker, "LWS_DiagnosticBuildings", "integer", 0 );
    $AddAttribute ( Attacker, "LWS_DiagnosticLairsIgnored", "integer", 0 );
    OriginalStrength = $GetAttribute ( Attacker, #ATTRIB_Strength );
    $SetAttribute ( Attacker, #ATTRIB_Strength, 1000 );

    // Phase 1: every field exists on this individual monster and initialization is idempotent.
    if ( Attacker's "LWS_StateVersion" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Level" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_KillsThisLevel" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_TotalKills" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_BuildingsDestroyed" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_ProgressClass" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Perks" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    // Expansion LevelXP classification boundaries.
    if ( $LWS_ClassFromLevelXP ( 0 ) != 0 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 250 ) != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 251 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 550 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 551 ) != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 900 ) != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 901 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 2000 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 2001 ) != 5 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    if ( $LWS_KillsRequired ( 1, 1 ) != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 2, 1 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 3, 1 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 4, 1 ) != 12 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 5, 1 ) != 20 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    Attacker's "LWS_TotalKills" = 7;
    $LWS_EnsureMonsterState ( Attacker );
    if ( Attacker's "LWS_TotalKills" != 7 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    Attacker's "LWS_TotalKills" = 0;

    EnemyTarget = $SpawnUnit ( Palace, "Peasant", $RandomCoord ( TestLocation, 50 ), #Player_1 );
    $SetAttribute ( EnemyTarget, #ATTRIB_HP, 1 );
    $SetAttribute ( EnemyTarget, #ATTRIB_armor_basic_damage, 0 );
    $damage ( Attacker, EnemyTarget );

    if ( Attacker's "LWS_DiagnosticKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_TotalKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Level" != 2 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( Attacker, #ATTRIB_ExperienceLevel ) != 2 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    FriendlyTarget = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( TestLocation, 50 ), #Monster_Player );
    $SetAttribute ( FriendlyTarget, #ATTRIB_HP, 1 );
    $SetAttribute ( FriendlyTarget, #ATTRIB_armor_basic_damage, 0 );
    $damage ( Attacker, FriendlyTarget );

    if ( Attacker's "LWS_DiagnosticKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    LairTarget = $SpawnUnit ( Palace, "Goblin_Hovel", $RandomCoord ( TestLocation, 100 ), "MaxHP", #Player_1 );
    $SetAttribute ( LairTarget, #ATTRIB_HP, 1 );
    $damage ( Attacker, LairTarget );

    if ( Attacker's "LWS_DiagnosticLairsIgnored" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    BuildingTarget = $SpawnUnit ( Palace, "Blacksmith1", $RandomCoord ( TestLocation, 100 ), "MaxHP", #Player_1 );
    $SetAttribute ( BuildingTarget, #ATTRIB_HP, 1 );
    $damage ( Attacker, BuildingTarget );

    if ( Attacker's "LWS_DiagnosticBuildings" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    // Observable arena: the same surviving rat can naturally hunt nine nearby peasants.
    // Together with the controlled first kill, ten total kills take a starter from level 1 to level 5.
    $SetAttribute ( Attacker, #ATTRIB_Strength, OriginalStrength );
    PeasantCount = 0;
    while ( PeasantCount < 9 ) do
        begin
            ArenaPeasant = $SpawnUnit ( Palace, "Peasant", $RandomCoord ( TestLocation, 50, 220 ), #Player_1 );
            PeasantCount += 1;
        end

    // Visible progression-class showcase. Each survivor is prepared exactly to level 2.
    ShowcaseMonster = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 1, 1 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    ShowcaseMonster = $SpawnUnit ( Palace, "Ratman", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 2, 2 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    ShowcaseMonster = $SpawnUnit ( Palace, "Troll", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 3, 4 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    ShowcaseMonster = $SpawnUnit ( Palace, "Minotaur", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 4, 12 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    ShowcaseMonster = $SpawnUnit ( Palace, "Dragon", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 5, 20 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    if ( AIRootAgent's "LWS_DiagnosticFailures" == 0 )
        begin
            AIRootAgent's "LWS_DiagnosticPassed" = TRUE;
            // Visible result that does not depend on autonomous hero or monster behavior.
            $AdjustPlayerData ( Palace, "gold", 7777 );
            $DebugOut ( 911, "LWS PROGRESSION CLASS DIAGNOSTIC: PASS" );
        end
    else
        begin
            $AdjustPlayerData ( Palace, "gold", 111 );
            $DebugOut ( 911, "LWS PROGRESSION CLASS DIAGNOSTIC: FAIL", AIRootAgent's "LWS_DiagnosticFailures" );
        end
End
