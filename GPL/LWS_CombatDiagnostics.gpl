////////////////////////////////////////////////////////////////////////////////////////////////////////
// Phase 0 diagnostic hook for the Northern Expansion combat pipeline.
// No production progression, stat growth, perk, or loot behavior belongs in this file.
////////////////////////////////////////////////////////////////////////////////////////////////////////

Function LWSCombatDiagnostic ()
Declare
    agent AIRootAgent, Palace;
    list Palaces;
Begin
    // Keep the known-good production bootstrap in the diagnostic quest.
    $LivingWorldSandbox ();

    Palaces = $ListPalaces ();
    Palace = $ListMember ( Palaces, 1 );
    AIRootAgent = $RetrieveAgent ( "GplAIRoot" );

    $AddAttribute ( AIRootAgent, "LWS_DiagnosticPassed", "boolean", FALSE );
    $AddAttribute ( AIRootAgent, "LWS_DiagnosticFailures", "integer", 0 );
    $AddAttribute ( AIRootAgent, "LWS_DiagnosticLootDrops", "integer", 0 );

    // This is a short deterministic integration check, so run it synchronously.
    // Majesty threads must be started through an agent function attribute; passing
    // a bare function to NewThread compiles but does not execute reliably at runtime.
    $LWS_RunCombatDiagnostic ( AIRootAgent, Palace );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_RunLootDiagnostic ( agent AIRootAgent, agent Palace, coordinate TestLocation ) is boolean
Declare
    agent NoDropVictim, DropVictim, LootDrop, LootHero;
    integer PotionsBefore;
Begin
    NoDropVictim = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( TestLocation, 80, 160 ), #Monster_Player );
    if ( $IsValidGamePiece ( NoDropVictim ) == FALSE )
        return FALSE;
    $SetAttribute ( NoDropVictim, #ATTRIB_HP, 1 );
    $LWS_TryHealingPotionDrop ( NoDropVictim, 1, 99 );
    if ( $HasAttribute ( "LWS_LootResolved", NoDropVictim ) == FALSE )
        return FALSE;
    if ( AIRootAgent's "LWS_DiagnosticLootDrops" != 0 )
        return FALSE;

    DropVictim = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( TestLocation, 80, 160 ), #Monster_Player );
    if ( $IsValidGamePiece ( DropVictim ) == FALSE )
        return FALSE;
    $SetAttribute ( DropVictim, #ATTRIB_HP, 1 );
    $LWS_TryHealingPotionDrop ( DropVictim, 1, 0 );
    if ( AIRootAgent's "LWS_DiagnosticLootDrops" != 1 )
        return FALSE;

    LootDrop = $SpawnUnit ( DropVictim, "LWS_HealingPotion", "Override", $Concatenate ( $MakeInventoryAttribute ( "LWS_HealingPotion" ), 0 ));
    if ( $IsValidGamePiece ( LootDrop ) == FALSE )
        return FALSE;

    LootHero = $SpawnUnit ( Palace, "Rogue", $RandomCoord ( TestLocation, 80, 160 ), #Player_1 );
    if ( $IsValidGamePiece ( LootHero ) == FALSE )
        return FALSE;
    $SetAttribute ( LootHero, #ATTRIB_NumHealingPotions, 0 );
    PotionsBefore = $GetAttribute ( LootHero, #ATTRIB_NumHealingPotions );
    $TransferInventoryItem ( "LWS_HealingPotion", LootDrop, LootHero );
    $LWS_HealingPotion_Transfer ( LootDrop, LootHero, $MakeInventoryAttribute ( "LWS_HealingPotion" ));
    $DeleteGamePiece ( LootDrop );

    if ( $GetAttribute ( LootHero, #ATTRIB_NumHealingPotions ) != ( PotionsBefore + 1 ))
        return FALSE;
    if ( $IsValidGamePiece ( LootDrop ))
        return FALSE;
    $DeleteGamePiece ( LootHero );
    return TRUE;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_SetupPotionArena ( agent Palace )
Declare
    agent WarriorsGuild, Paladin, Enemy, PotionDrop;
    coordinate ArenaLocation;
    integer EnemyCount, PotionCount;
Begin
    ArenaLocation = $RandomCoord ( Palace, 700, 900 );
    WarriorsGuild = $SpawnUnit ( Palace, "Warriors_Guild", ArenaLocation, "MaxHP", #Player_1 );
    if ( $IsValidGamePiece ( WarriorsGuild ) == FALSE )
        return;

    Paladin = $SpawnUnit ( WarriorsGuild, "Paladin", $RandomCoord ( WarriorsGuild, 40, 80 ), #Player_1 );
    if ( $IsValidGamePiece ( Paladin ) == FALSE )
        return;
    if ( Paladin's "home" == $NullAgent ())
        $Adopt ( WarriorsGuild, Paladin );

    $Advance_To_Level ( Paladin, 8 );
    $SetAttribute ( Paladin, #ATTRIB_HP, $GetAttribute ( Paladin, #ATTRIB_MaxHP ) / 2 );
    $SetAttribute ( Paladin, #ATTRIB_NumHealingPotions, 0 );

    EnemyCount = 0;
    while ( EnemyCount < 6 ) do
        begin
            if (( EnemyCount % 2 ) == 0 )
                Enemy = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( Paladin, 60, 150 ), #Monster_Player );
            else
                Enemy = $SpawnUnit ( Palace, "Skeleton", $RandomCoord ( Paladin, 60, 150 ), #Monster_Player );
            EnemyCount += 1;
        end

    PotionCount = 0;
    while ( PotionCount < 10 ) do
        begin
            PotionDrop = $SpawnUnit ( Paladin, "LWS_HealingPotion", $RandomCoord ( Paladin, 30, 100 ), "Override", $Concatenate ( $MakeInventoryAttribute ( "LWS_HealingPotion" ), 0 ));
            PotionCount += 1;
        end
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_PrepareClassShowcase ( agent Monster, integer ExpectedClass, integer KillCredits ) is boolean
Declare
    integer CreditCount, OldMaxHP, OldHP, HPBonus;
    integer OldHtoH, OldRanged, OldDodge, OldParry, OldStrength, OldMagicResistance;
Begin
    if ( $IsValidGamePiece ( Monster ) == FALSE )
        return FALSE;

    $LWS_EnsureMonsterState ( Monster );
    if ( Monster's "LWS_ProgressClass" != ExpectedClass )
        return FALSE;

    OldMaxHP = $GetAttribute ( Monster, #ATTRIB_MaxHP );
    OldHP = OldMaxHP / 2;
    $SetAttribute ( Monster, #ATTRIB_HP, OldHP );
    HPBonus = ( OldMaxHP * 5 ) / 100;
    if ( HPBonus < 1 ) HPBonus = 1;
    OldHtoH = $GetAttribute ( Monster, #ATTRIB_HtoH );
    OldRanged = $GetAttribute ( Monster, #ATTRIB_Ranged );
    OldDodge = $GetAttribute ( Monster, #ATTRIB_Dodge );
    OldParry = $GetAttribute ( Monster, #ATTRIB_Parry );
    OldStrength = $GetAttribute ( Monster, #ATTRIB_Strength );
    OldMagicResistance = $GetAttribute ( Monster, #ATTRIB_MagicResistance );

    CreditCount = 0;
    while ( CreditCount < KillCredits ) do
        begin
            $LWS_RecordUnitKill ( Monster );
            CreditCount += 1;
        end

    if ( Monster's "LWS_Level" != 2 )
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_ExperienceLevel ) != 2 )
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_MaxHP ) != ( OldMaxHP + HPBonus ))
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_HP ) != ( OldHP + HPBonus ))
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_HP ) == $GetAttribute ( Monster, #ATTRIB_MaxHP ))
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_Dodge ) != ( OldDodge + 1 ))
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_Parry ) != ( OldParry + 1 ))
        return FALSE;
    if (( Monster's "attacktype" == 1 ) &&
        ( $GetAttribute ( Monster, #ATTRIB_HtoH ) != ( OldHtoH + 1 )))
        return FALSE;
    if (( Monster's "attacktype" == 2 ) &&
        ( $GetAttribute ( Monster, #ATTRIB_Ranged ) != ( OldRanged + 1 )))
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_Strength ) != OldStrength )
        return FALSE;
    if ( $GetAttribute ( Monster, #ATTRIB_MagicResistance ) != OldMagicResistance )
        return FALSE;
    return TRUE;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_RunCombatDiagnostic ( agent AIRootAgent, agent Palace )
Declare
    agent Attacker, EnemyTarget, FriendlyTarget, LairTarget, BuildingTarget, ArenaPeasant, ShowcaseMonster, PerkTester;
    coordinate TestLocation;
    integer OriginalStrength, PeasantCount;
    integer OldHtoH, OldStrength, OldArmor, OldParry, OldDodge, OldMagicResistance;
Begin
    TestLocation = $RandomCoord ( Palace, 300, 500 );
    Attacker = $SpawnUnit ( Palace, "Giant_Rat", TestLocation, #Monster_Player );
    $LWS_EnsureMonsterState ( Attacker );
    $AddAttribute ( Attacker, "LWS_DiagnosticKills", "integer", 0 );
    $AddAttribute ( Attacker, "LWS_DiagnosticBuildings", "integer", 0 );
    $AddAttribute ( Attacker, "LWS_DiagnosticLairsIgnored", "integer", 0 );
    OriginalStrength = $GetAttribute ( Attacker, #ATTRIB_Strength );
    $SetAttribute ( Attacker, #ATTRIB_Strength, 1000 );

    // Phase 1: every field exists on this individual monster and initialization is idempotent.
    if ( Attacker's "LWS_StateVersion" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Level" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_KillsThisLevel" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_TotalKills" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_BuildingsDestroyed" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_ProgressClass" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Perks" != 0 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    // Expansion LevelXP classification boundaries.
    if ( $LWS_ClassFromLevelXP ( 0 ) != 0 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 250 ) != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 251 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 550 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 551 ) != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 900 ) != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 901 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 2000 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_ClassFromLevelXP ( 2001 ) != 5 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    if ( $LWS_KillsRequired ( 1, 1 ) != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 2, 1 ) != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 3, 1 ) != 4 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 4, 1 ) != 12 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $LWS_KillsRequired ( 5, 1 ) != 20 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    Attacker's "LWS_TotalKills" = 7;
    $LWS_EnsureMonsterState ( Attacker );
    if ( Attacker's "LWS_TotalKills" != 7 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    Attacker's "LWS_TotalKills" = 0;

    EnemyTarget = $SpawnUnit ( Palace, "Peasant", $RandomCoord ( TestLocation, 50 ), #Player_1 );
    $SetAttribute ( EnemyTarget, #ATTRIB_HP, 1 );
    $SetAttribute ( EnemyTarget, #ATTRIB_armor_basic_damage, 0 );
    $damage ( Attacker, EnemyTarget );

    if ( Attacker's "LWS_DiagnosticKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_TotalKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_Level" != 2 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( Attacker, #ATTRIB_ExperienceLevel ) != 2 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    FriendlyTarget = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( TestLocation, 50 ), #Monster_Player );
    $SetAttribute ( FriendlyTarget, #ATTRIB_HP, 1 );
    $SetAttribute ( FriendlyTarget, #ATTRIB_armor_basic_damage, 0 );
    $damage ( Attacker, FriendlyTarget );

    if ( Attacker's "LWS_DiagnosticKills" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    LairTarget = $SpawnUnit ( Palace, "Goblin_Hovel", $RandomCoord ( TestLocation, 100 ), "MaxHP", #Player_1 );
    $SetAttribute ( LairTarget, #ATTRIB_HP, 1 );
    $damage ( Attacker, LairTarget );

    if ( Attacker's "LWS_DiagnosticLairsIgnored" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    BuildingTarget = $SpawnUnit ( Palace, "Blacksmith1", $RandomCoord ( TestLocation, 100 ), "MaxHP", #Player_1 );
    $SetAttribute ( BuildingTarget, #ATTRIB_HP, 1 );
    $damage ( Attacker, BuildingTarget );

    if ( Attacker's "LWS_DiagnosticBuildings" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( Attacker's "LWS_BuildingsDestroyed" != 1 )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    // Deterministic building reward and cap checks, isolated from the random production roll above.
    // A unique expansion unit makes the three-perk result easy to inspect in the UI.
    PerkTester = $SpawnUnit ( Palace, "GoblinOverlord", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $IsValidGamePiece ( PerkTester ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    else
        begin
    $LWS_EnsureMonsterState ( PerkTester );
    OldHtoH = $GetAttribute ( PerkTester, #ATTRIB_HtoH );
    OldStrength = $GetAttribute ( PerkTester, #ATTRIB_Strength );
    OldArmor = $GetAttribute ( PerkTester, #ATTRIB_armor_basic_damage );
    OldParry = $GetAttribute ( PerkTester, #ATTRIB_Parry );
    OldDodge = $GetAttribute ( PerkTester, #ATTRIB_Dodge );
    OldMagicResistance = $GetAttribute ( PerkTester, #ATTRIB_MagicResistance );

    $LWS_ProcessBuildingDestroyed ( PerkTester, 99, 0 );
    if ( PerkTester's "LWS_BuildingsDestroyed" != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( PerkTester's "LWS_Perks" != 0 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    $LWS_ProcessBuildingDestroyed ( PerkTester, 0, 0 );
    if ( PerkTester's "LWS_Perks" != 1 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_HtoH ) != ( OldHtoH + 2 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_Strength ) != ( OldStrength + 1 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    $LWS_ProcessBuildingDestroyed ( PerkTester, 0, 1 );
    if ( PerkTester's "LWS_Perks" != 2 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_armor_basic_damage ) != ( OldArmor + 1 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_Parry ) != ( OldParry + 1 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_Dodge ) != ( OldDodge + 1 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    $LWS_ProcessBuildingDestroyed ( PerkTester, 0, 2 );
    if ( PerkTester's "LWS_Perks" != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_MagicResistance ) != ( OldMagicResistance + 3 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;

    $LWS_ProcessBuildingDestroyed ( PerkTester, 0, 0 );
    if ( PerkTester's "LWS_BuildingsDestroyed" != 5 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( PerkTester's "LWS_Perks" != 3 ) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $GetAttribute ( PerkTester, #ATTRIB_HtoH ) != ( OldHtoH + 2 )) AIRootAgent's "LWS_DiagnosticFailures" += 1;
    $DeleteGamePiece ( PerkTester );
        end

    // Observable arena: the same surviving rat can naturally hunt nine nearby peasants.
    // Together with the controlled first kill, ten total kills take a starter from level 1 to level 5.
    $SetAttribute ( Attacker, #ATTRIB_Strength, OriginalStrength );
    PeasantCount = 0;
    while ( PeasantCount < 9 ) do
        begin
            ArenaPeasant = $SpawnUnit ( Palace, "Peasant", $RandomCoord ( TestLocation, 50, 220 ), #Player_1 );
            PeasantCount += 1;
        end

    // Visible progression-class showcase. Each survivor is prepared exactly to level 2.
    ShowcaseMonster = $SpawnUnit ( Palace, "Giant_Rat", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 1, 1 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $IsValidGamePiece ( ShowcaseMonster )) $DeleteGamePiece ( ShowcaseMonster );

    ShowcaseMonster = $SpawnUnit ( Palace, "Ratman", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 2, 2 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $IsValidGamePiece ( ShowcaseMonster )) $DeleteGamePiece ( ShowcaseMonster );

    ShowcaseMonster = $SpawnUnit ( Palace, "Troll", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 3, 4 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $IsValidGamePiece ( ShowcaseMonster )) $DeleteGamePiece ( ShowcaseMonster );

    ShowcaseMonster = $SpawnUnit ( Palace, "Minotaur", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 4, 12 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $IsValidGamePiece ( ShowcaseMonster )) $DeleteGamePiece ( ShowcaseMonster );

    ShowcaseMonster = $SpawnUnit ( Palace, "Dragon", $RandomCoord ( Palace, 350, 550 ), #Monster_Player );
    if ( $LWS_PrepareClassShowcase ( ShowcaseMonster, 5, 20 ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;
    if ( $IsValidGamePiece ( ShowcaseMonster )) $DeleteGamePiece ( ShowcaseMonster );

    if ( $LWS_RunLootDiagnostic ( AIRootAgent, Palace, TestLocation ) == FALSE )
        AIRootAgent's "LWS_DiagnosticFailures" += 1;

    if ( AIRootAgent's "LWS_DiagnosticFailures" == 0 )
        begin
            AIRootAgent's "LWS_DiagnosticPassed" = TRUE;
            // Visible result that does not depend on autonomous hero or monster behavior.
            $AdjustPlayerData ( Palace, "gold", 7777 );
            $DebugOut ( 911, "LWS PROGRESSION CLASS DIAGNOSTIC: PASS" );
        end
    else
        begin
            $AdjustPlayerData ( Palace, "gold", 111 );
            $DebugOut ( 911, "LWS PROGRESSION CLASS DIAGNOSTIC: FAIL", AIRootAgent's "LWS_DiagnosticFailures" );
        end

    // Autonomous, observable loot arena; its random combat outcome cannot change PASS/FAIL.
    $LWS_SetupPotionArena ( Palace );
End
