////////////////////////////////////////////////////////////////////////////////////////////////////////
// LivingWorldSandbox - central, extensible monster loot policy and two-slot resolver.
////////////////////////////////////////////////////////////////////////////////////////////////////////

// Rarity codes: 0=None, 1=Common, 2=Uncommon, 3=Rare, 4=Epic, 5=Legendary.
Function LWS_LootMinimumRarity ( integer ProgressClass ) is integer
Declare
Begin
    if ( ProgressClass <= 0 ) return 0;
    if ( ProgressClass <= 2 ) return 1;
    if ( ProgressClass == 3 ) return 2;
    if ( ProgressClass == 4 ) return 3;
    return 4;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_LootMaximumRarity ( integer ProgressClass ) is integer
Declare
Begin
    if ( ProgressClass <= 0 ) return 0;
    if ( ProgressClass == 1 ) return 1;
    if ( ProgressClass == 2 ) return 2;
    if ( ProgressClass == 3 ) return 3;
    if ( ProgressClass == 4 ) return 4;
    return 5;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_LootGuaranteesEpic ( integer ProgressClass ) is boolean
Declare
Begin
    return ProgressClass == 5;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Potion and every optional production loot channel use the same base chance.
Function LWS_OptionalLootDropSucceeds ( integer ChanceRoll ) is boolean
Declare
Begin
    return ChanceRoll < 8;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Class 5 always supplies its one equipment candidate. Other classes use the 8% base chance.
Function LWS_EquipmentDropSucceeds ( integer ProgressClass, integer ChanceRoll ) is boolean
Declare
Begin
    if ( ProgressClass == 5 ) return TRUE;
    return $LWS_OptionalLootDropSucceeds ( ChanceRoll );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Selects rarity only after an equipment drop succeeds.
// Classes 2-4 yield the previous league 75% and their ceiling 25% of the time.
Function LWS_SelectLootRarity ( integer ProgressClass, integer RarityRoll ) is integer
Declare
Begin
    if ( ProgressClass <= 0 ) return 0;
    if ( ProgressClass == 1 ) return 1;
    if ( ProgressClass == 2 )
        begin
            if ( RarityRoll < 75 ) return 1;
            return 2;
        end
    if ( ProgressClass == 3 )
        begin
            if ( RarityRoll < 75 ) return 2;
            return 3;
        end
    if ( ProgressClass == 4 )
        begin
            if ( RarityRoll < 75 ) return 3;
            return 4;
        end
    // Class 5 upgrades its guaranteed Epic candidate to Legendary on a 1% roll.
    if ( RarityRoll < 1 ) return 5;
    return 4;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legendary requires both Class 5 and an explicit source whitelist marker.
Function LWS_IsLegendaryLootSource ( agent Monster ) is boolean
Declare
Begin
    if ( $IsValidGamePiece ( Monster ) == FALSE ) return FALSE;
    $LWS_EnsureMonsterState ( Monster );
    if ( Monster's "LWS_ProgressClass" != 5 ) return FALSE;
    if ( $HasAttribute ( "LWS_LegendaryLootSource", Monster ) == FALSE ) return FALSE;
    return Monster's "LWS_LegendaryLootSource";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_HealingPotion_Birth ( agent ThisAgent )
Declare
Begin
    $AddAttribute ( ThisAgent, "TransferScript", "function", $LWS_HealingPotion_Transfer );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_HealingPotion_Transfer ( agent OldOwnerAgent, agent NewOwnerAgent, integer AttributeID )
Declare
Begin
    if ( $IsValidGamePiece ( NewOwnerAgent ) == FALSE ) return;

    // Marketplace purchases and Ranger brewing use this same native counter.
    if ( $GetAttribute ( NewOwnerAgent, #ATTRIB_NumHealingPotions ) < #Max_Heal_Potions )
        $AdjustAttribute ( NewOwnerAgent, #ATTRIB_NumHealingPotions, 1 );

    // The world pickup is a consumable carrier, not a persistent custom inventory item.
    $DeleteInventoryItem ( AttributeID, NewOwnerAgent );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_SpawnLootItem ( agent Defender, string DropTitle ) is boolean
Declare
    agent Drop;
Begin
    if ( Defender's "LWS_LootSlotsUsed" >= 2 ) return FALSE;

    Drop = $SpawnUnit ( Defender, DropTitle, "Override", $Concatenate ( $MakeInventoryAttribute ( DropTitle ), 0 ));
    if ( $IsValidGamePiece ( Drop ) == FALSE ) return FALSE;

    Defender's "LWS_LootSlotsUsed" += 1;
    return TRUE;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_TryHealingPotionSlot ( agent Defender, integer ChanceRoll )
Declare
    agent AIRootAgent;
Begin
    if ( $LWS_OptionalLootDropSucceeds ( ChanceRoll ) == FALSE ) return;
    if ( $LWS_SpawnLootItem ( Defender, "LWS_HealingPotion" ) == FALSE ) return;

    AIRootAgent = $RetrieveAgent ( "GplAIRoot" );
    if ( $HasAttribute ( "LWS_DiagnosticLootDrops", AIRootAgent ))
        AIRootAgent's "LWS_DiagnosticLootDrops" += 1;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_TryDiagnosticWeaponSlot ( agent Defender, integer ChanceRoll )
Declare
    agent AIRootAgent;
Begin
    AIRootAgent = $RetrieveAgent ( "GplAIRoot" );
    if ( $HasAttribute ( "LWS_DiagnosticWeaponDropChance", AIRootAgent ) == FALSE ) return;
    if ( ChanceRoll >= AIRootAgent's "LWS_DiagnosticWeaponDropChance" ) return;
    if ( $LWS_SpawnLootItem ( Defender, "LWS_T2_Longsword_Plus6" ))
        $DebugOut ( 911, "LWS DIAGNOSTIC WEAPON DROP", "LWS_T2_Longsword_Plus6" );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_TryDiagnosticArmorSlot ( agent Defender, integer ChanceRoll )
Declare
    agent AIRootAgent;
Begin
    AIRootAgent = $RetrieveAgent ( "GplAIRoot" );
    if ( $HasAttribute ( "LWS_DiagnosticArmorDropChance", AIRootAgent ) == FALSE ) return;
    if ( ChanceRoll >= AIRootAgent's "LWS_DiagnosticArmorDropChance" ) return;
    if ( $LWS_SpawnLootItem ( Defender, "LWS_T2_Armor_Plus6" ))
        $DebugOut ( 911, "LWS DIAGNOSTIC ARMOR DROP", "LWS_T2_Armor_Plus6" );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// The only fatal-hit entry point. Every current and future item type must consume one of these slots.
Function LWS_ResolveMonsterLoot ( agent Defender, integer FinalDamage,
                                  integer PotionRoll, integer WeaponRoll, integer ArmorRoll )
Declare
    integer DefenderHP;
Begin
    if ( $IsValidGamePiece ( Defender ) == FALSE ) return;
    if ( $HasAttribute ( "original_type", Defender ) == FALSE ) return;
    if ( Defender's "original_type" != "Monster" ) return;

    DefenderHP = $GetAttribute ( Defender, #ATTRIB_HP );
    if (( DefenderHP <= 0 ) || ( DefenderHP > FinalDamage )) return;
    if ( $HasAttribute ( "LWS_LootResolved", Defender )) return;

    $AddAttribute ( Defender, "LWS_LootResolved", "boolean", TRUE );
    $AddAttribute ( Defender, "LWS_LootSlotsUsed", "integer", 0 );
    $LWS_EnsureMonsterState ( Defender );

    // Slot candidates are centralized. More item types may be inserted here without raising the cap.
    $LWS_TryHealingPotionSlot ( Defender, PotionRoll );
    $LWS_TryDiagnosticWeaponSlot ( Defender, WeaponRoll );
    $LWS_TryDiagnosticArmorSlot ( Defender, ArmorRoll );
End
