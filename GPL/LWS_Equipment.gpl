////////////////////////////////////////////////////////////////////////////////////////////////////////
// LivingWorldSandbox - tiered hero equipment and Blacksmith integration.
////////////////////////////////////////////////////////////////////////////////////////////////////////

Function LWS_WeaponTierBaseBonus ( integer Tier ) is integer
Declare
Begin
    if ( Tier == 4 ) return 3;
    if ( Tier == 3 ) return 2;
    if ( Tier == 2 ) return 1;
    return 0;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_WeaponEffectiveBonus ( integer Tier, integer AffixBonus ) is integer
Declare
Begin
    return $LWS_WeaponTierBaseBonus ( Tier ) + AffixBonus;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ArmorTierBaseBonus ( integer Tier ) is integer
Declare
Begin
    return $LWS_WeaponTierBaseBonus ( Tier );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ArmorEffectiveBonus ( integer Tier, integer AffixBonus ) is integer
Declare
Begin
    // Northern Expansion applies Armor_Magic_Bonus at twice its displayed value.
    return $LWS_ArmorTierBaseBonus ( Tier ) + ( AffixBonus * 2 );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EquipmentPower ( string EquipmentType, integer Tier, integer AffixBonus ) is integer
Declare
Begin
    if ( EquipmentType == "Armor" ) return $LWS_ArmorEffectiveBonus ( Tier, AffixBonus );
    return $LWS_WeaponEffectiveBonus ( Tier, AffixBonus );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Legendary is deliberately excluded: it is assigned only by the future unique-item whitelist.
Function LWS_EquipmentRarity ( string EquipmentType, integer Tier, integer AffixBonus ) is string
Declare
    integer Power;
Begin
    Power = $LWS_EquipmentPower ( EquipmentType, Tier, AffixBonus );
    if ( Power <= 1 ) return "Common";
    if ( Power <= 3 ) return "Uncommon";
    if ( Power <= 6 ) return "Rare";
    return "Epic";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ConfigureEquipmentDrop ( agent Item, string EquipmentType, string EquipmentFamily,
                                      integer Tier, integer AffixBonus )
Declare
Begin
    if ( $IsValidGamePiece ( Item ) == FALSE ) return;
    if ( EquipmentType == "Armor" )
        Item's "TransferScript" = $LWS_EquipArmorTransfer;
    else
        Item's "TransferScript" = $LWS_EquipWeaponTransfer;
    Item's "LWS_EquipmentType" = EquipmentType;
    Item's "LWS_EquipmentFamily" = EquipmentFamily;
    $AddAttribute ( Item, "LWS_EquipmentTier", "integer", Tier );
    $AddAttribute ( Item, "LWS_EquipmentAffixBonus", "integer", AffixBonus );
    $AddAttribute ( Item, "LWS_EquipmentRarity", "string", $LWS_EquipmentRarity ( EquipmentType, Tier, AffixBonus ));
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_InitializeWeaponDrop ( agent ThisAgent, string EquipmentFamily )
Declare
Begin
    // Classification is required during BirthScript: hero AI can evaluate a newly spawned
    // Special_Item before the loot generator has supplied its rolled tier and affix.
    $AddAttribute ( ThisAgent, "TransferScript", "function", $LWS_EquipWeaponTransfer );
    $AddAttribute ( ThisAgent, "LWS_EquipmentType", "string", "Weapon" );
    $AddAttribute ( ThisAgent, "LWS_EquipmentFamily", "string", EquipmentFamily );
End

Function LWS_InitializeArmorDrop ( agent ThisAgent, string EquipmentFamily )
Declare
Begin
    $AddAttribute ( ThisAgent, "TransferScript", "function", $LWS_EquipArmorTransfer );
    $AddAttribute ( ThisAgent, "LWS_EquipmentType", "string", "Armor" );
    $AddAttribute ( ThisAgent, "LWS_EquipmentFamily", "string", EquipmentFamily );
End

Function LWS_StaffDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Staff" ); End
Function LWS_AxeclubDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Axeclub" ); End
Function LWS_DaggerDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Dagger" ); End
Function LWS_LongswordDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Longsword" ); End
Function LWS_LongbowDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Longbow" ); End
Function LWS_CrossbowDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Crossbow" ); End
Function LWS_MaceDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Mace" ); End
Function LWS_ChaosWeaponDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Chaos" ); End
Function LWS_HammerDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeWeaponDrop ( ThisAgent, "Hammer" ); End
Function LWS_LeatherDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeArmorDrop ( ThisAgent, "Leather" ); End
Function LWS_ChainDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeArmorDrop ( ThisAgent, "Chain" ); End
Function LWS_PlateDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeArmorDrop ( ThisAgent, "Plate" ); End
Function LWS_ChaosArmorDrop_Birth ( agent ThisAgent ) Declare Begin $LWS_InitializeArmorDrop ( ThisAgent, "Chaos" ); End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Northern Expansion equipment families, resolved from M_Characters.xml + MX_Characters.xml.
Function LWS_HeroWeaponFamily ( agent Hero ) is string
Declare
    string Title;
Begin
    if ( $IsValidGamePiece ( Hero ) == FALSE ) return "None";
    Title = Hero's "Title";
    if ( Title == "Adept" || Title == "Priestess" || Title == "Wizard" ) return "Staff";
    if ( Title == "Barbarian" ) return "Axeclub";
    if ( Title == "Cultist" || Title == "Healer" || Title == "Gnome" || Title == "Gnomechamp" ) return "Dagger";
    if ( Title == "Paladin" || Title == "Warrior" ) return "Longsword";
    if ( Title == "Ranger" || Title == "Elf" ) return "Longbow";
    if ( Title == "Rogue" ) return "Crossbow";
    if ( Title == "Solarus" ) return "Mace";
    if ( Title == "Warrior_of_Discord" ) return "Chaos";
    if ( Title == "Dwarf" ) return "Hammer";
    if ( Title == "Monk" ) return "None";
    return "None";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_HeroArmorFamily ( agent Hero ) is string
Declare
    string Title;
Begin
    if ( $IsValidGamePiece ( Hero ) == FALSE ) return "None";
    Title = Hero's "Title";
    if ( Title == "Adept" || Title == "Cultist" || Title == "Ranger" || Title == "Rogue" || Title == "Gnomechamp" ) return "Leather";
    if ( Title == "Paladin" || Title == "Warrior" || Title == "Dwarf" ) return "Plate";
    if ( Title == "Solarus" || Title == "Elf" ) return "Chain";
    if ( Title == "Warrior_of_Discord" ) return "Chaos";
    if ( Title == "Barbarian" || Title == "Healer" || Title == "Monk" || Title == "Priestess" || Title == "Wizard" || Title == "Gnome" ) return "None";
    return "None";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_IsEquipmentCompatible ( agent Hero, agent Item ) is boolean
Declare
Begin
    if ( $HasAttribute ( "LWS_EquipmentType", Item ) == FALSE ) return FALSE;
    if ( $HasAttribute ( "LWS_EquipmentFamily", Item ) == FALSE ) return FALSE;
    if ( Item's "LWS_EquipmentType" == "Armor" )
        return Item's "LWS_EquipmentFamily" == $LWS_HeroArmorFamily ( Hero );
    if ( Item's "LWS_EquipmentType" == "Weapon" )
        return Item's "LWS_EquipmentFamily" == $LWS_HeroWeaponFamily ( Hero );
    return FALSE;
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EnsureWeaponEquipmentState ( agent Hero )
Declare
Begin
    if ( $HasAttribute ( "LWS_WeaponBaseDamage", Hero ) == FALSE )
        $AddAttribute ( Hero, "LWS_WeaponBaseDamage", "integer", $GetAttribute ( Hero, #ATTRIB_Weapon_Basic_Damage ));
    if ( $HasAttribute ( "LWS_WeaponTier", Hero ) == FALSE )
        $AddAttribute ( Hero, "LWS_WeaponTier", "integer", 1 );
    if ( $HasAttribute ( "LWS_WeaponAffixBonus", Hero ) == FALSE )
        $AddAttribute ( Hero, "LWS_WeaponAffixBonus", "integer", 0 );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EnsureArmorEquipmentState ( agent Hero )
Declare
Begin
    if ( $HasAttribute ( "LWS_ArmorTier", Hero ) == FALSE )
        $AddAttribute ( Hero, "LWS_ArmorTier", "integer", 1 );
    if ( $HasAttribute ( "LWS_ArmorAffixBonus", Hero ) == FALSE )
        $AddAttribute ( Hero, "LWS_ArmorAffixBonus", "integer", 0 );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ShouldRetrieveWeapon ( agent Hero, agent Item ) is boolean
Declare
    integer ItemTier, ItemAffix, ItemEffective, CurrentEffective;
Begin
    if ( $IsValidGamePiece ( Hero ) == FALSE ) return FALSE;
    if ( $IsValidGamePiece ( Item ) == FALSE ) return FALSE;
    if ( $GetAttribute ( Hero, #ATTRIB_WeaponTypeIndex ) <= 0 ) return FALSE;
    if ( $LWS_IsEquipmentCompatible ( Hero, Item ) == FALSE ) return FALSE;
    if ( $HasAttribute ( "LWS_EquipmentTier", Item ) == FALSE ) return FALSE;
    if ( $HasAttribute ( "LWS_EquipmentAffixBonus", Item ) == FALSE ) return FALSE;

    ItemTier = Item's "LWS_EquipmentTier";
    ItemAffix = Item's "LWS_EquipmentAffixBonus";
    ItemEffective = $LWS_WeaponEffectiveBonus ( ItemTier, ItemAffix );
    if ( $HasAttribute ( "LWS_WeaponTier", Hero ))
        CurrentEffective = $LWS_WeaponEffectiveBonus ( Hero's "LWS_WeaponTier", Hero's "LWS_WeaponAffixBonus" );
    else
        CurrentEffective = $GetAttribute ( Hero, #ATTRIB_Weapon_Struct_Bonus );
    if ( ItemEffective > CurrentEffective ) return TRUE;
    if ( ItemEffective < CurrentEffective ) return FALSE;
    // Equal power: keep the larger affix because it retains more value after Blacksmith upgrades.
    if ( $HasAttribute ( "LWS_WeaponTier", Hero ) == FALSE ) return FALSE;
    if ( ItemAffix > Hero's "LWS_WeaponAffixBonus" ) return TRUE;
    if ( ItemAffix < Hero's "LWS_WeaponAffixBonus" ) return FALSE;
    return ItemTier > Hero's "LWS_WeaponTier";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ShouldRetrieveArmor ( agent Hero, agent Item ) is boolean
Declare
    integer ItemTier, ItemAffix, ItemEffective, CurrentEffective;
Begin
    if ( $IsValidGamePiece ( Hero ) == FALSE ) return FALSE;
    if ( $IsValidGamePiece ( Item ) == FALSE ) return FALSE;
    if ( $GetAttribute ( Hero, #ATTRIB_ArmorTypeIndex ) <= 0 ) return FALSE;
    if ( $LWS_IsEquipmentCompatible ( Hero, Item ) == FALSE ) return FALSE;
    if ( $HasAttribute ( "LWS_EquipmentTier", Item ) == FALSE ) return FALSE;
    if ( $HasAttribute ( "LWS_EquipmentAffixBonus", Item ) == FALSE ) return FALSE;

    ItemTier = Item's "LWS_EquipmentTier";
    ItemAffix = Item's "LWS_EquipmentAffixBonus";
    ItemEffective = $LWS_ArmorEffectiveBonus ( ItemTier, ItemAffix );
    if ( $HasAttribute ( "LWS_ArmorTier", Hero ))
        CurrentEffective = $LWS_ArmorEffectiveBonus ( Hero's "LWS_ArmorTier", Hero's "LWS_ArmorAffixBonus" );
    else
        CurrentEffective = $GetAttribute ( Hero, #ATTRIB_Armor_Struct_Bonus ) + ( $GetAttribute ( Hero, #ATTRIB_Armor_Magic_Bonus ) * 2 );
    if ( ItemEffective > CurrentEffective ) return TRUE;
    if ( ItemEffective < CurrentEffective ) return FALSE;
    if ( $HasAttribute ( "LWS_ArmorTier", Hero ) == FALSE ) return FALSE;
    if ( ItemAffix > Hero's "LWS_ArmorAffixBonus" ) return TRUE;
    if ( ItemAffix < Hero's "LWS_ArmorAffixBonus" ) return FALSE;
    return ItemTier > Hero's "LWS_ArmorTier";
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_ShouldRetrieveEquipment ( agent Hero, agent Item ) is boolean
Declare
Begin
    if ( $HasAttribute ( "LWS_EquipmentType", Item ) == FALSE ) return FALSE;
    if ( Item's "LWS_EquipmentType" == "Armor" ) return $LWS_ShouldRetrieveArmor ( Hero, Item );
    return $LWS_ShouldRetrieveWeapon ( Hero, Item );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Returns the first special item this hero can currently use. Inferior equipment remains available
// on the ground instead of being consumed by the vanilla retrieve-and-transfer sequence.
Function LWS_SelectDesiredSpecialItem ( agent Hero, list Items ) is agent
Declare
    agent Candidate;
Begin
    foreach Candidate in Items do
        begin
            if ( Candidate's "Title" == "LWS_HealingPotion" )
                begin
                    if ( $GetAttribute ( Hero, #ATTRIB_NumHealingPotions ) < #Max_Heal_Potions )
                        return Candidate;
                end
            else if ( $HasAttribute ( "LWS_LegendaryUnique", Candidate ))
                begin
                    if ( $LWS_CanReceiveLegendary ( Hero, Candidate ))
                        return Candidate;
                end
            else if ( $HasAttribute ( "LWS_EquipmentType", Candidate ))
                begin
                    if ( $LWS_ShouldRetrieveEquipment ( Hero, Candidate ))
                        return Candidate;
                end
            else
                return Candidate;
        end

    return $NullAgent ();
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
// Equipment drops deliberately use a private world type. Original hero BCDs contain direct calls to
// the vanilla Special_Item evaluator, so a quest-level replacement cannot reliably intercept every
// path. This selector is the sole entry point for equippable world loot.
Function LWS_SelectDesiredEquipmentDrop ( agent Hero, list Items ) is agent
Declare
    agent Candidate;
Begin
    foreach Candidate in Items do
        begin
            if ( $LWS_ShouldRetrieveEquipment ( Hero, Candidate ))
                return Candidate;
        end
    return $NullAgent ();
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EquipmentPickupDirector ( agent ThisAgent )
Declare
    agent Palace, Hero, Candidate, LegacyDrop;
    list Palaces, Heroes, Drops, LegacyDrops;
Begin
    Palaces = $ListPalaces ();
    Palace = $ListMember ( Palaces, 1 );
    if ( $IsValidGamePiece ( Palace ) == FALSE ) return;

    // Migrate equipment created by an older save/package before the private type existed.
    $ListObjects ( Palace, "Special_Item", -1, LegacyDrops, #NoHiddenMap );
    foreach LegacyDrop in LegacyDrops do
        begin
            if ( $HasAttribute ( "LWS_EquipmentType", LegacyDrop ))
                LegacyDrop's "Type" = "LWS_EquipmentDrop";
        end

    $ListObjects ( Palace, "hero", -1, Heroes, #NoHiddenMap, #MyPlayer );
    foreach Hero in Heroes do
        begin
            if ( Hero's "BackScript" != $Grab_Item )
                begin
                    $ListObjects ( Hero, "LWS_EquipmentDrop", $GetAttribute ( Hero, #ATTRIB_SightRange ), Drops, #NoHiddenMap );
                    Candidate = $LWS_SelectDesiredEquipmentDrop ( Hero, Drops );
                    if ( $IsValidGamePiece ( Candidate ) && $Is_Free_Task ( Hero, $Grab_Item, Candidate ))
                        begin
                            Hero's "Target" = Candidate;
                            Hero's "ActiveScript" = $Grab_Item;
                            Hero's "BackScript" = $Grab_Item;
                            $SpecifyIntent ( Hero, #intent_recovering_item );
                        end
                end
        end
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EquipArmorTransfer ( agent OldOwnerAgent, agent NewOwnerAgent, integer AttributeID )
Declare
    integer ItemTier, ItemAffix, ItemEffective;
Begin
    if ( $IsValidGamePiece ( NewOwnerAgent ) == FALSE ) return;

    if ( $LWS_ShouldRetrieveArmor ( NewOwnerAgent, OldOwnerAgent ))
        begin
            ItemTier = OldOwnerAgent's "LWS_EquipmentTier";
            ItemAffix = OldOwnerAgent's "LWS_EquipmentAffixBonus";
            ItemEffective = $LWS_ArmorEffectiveBonus ( ItemTier, ItemAffix );

            $LWS_EnsureArmorEquipmentState ( NewOwnerAgent );
            NewOwnerAgent's "LWS_ArmorTier" = ItemTier;
            NewOwnerAgent's "LWS_ArmorAffixBonus" = ItemAffix;
            $SetAttribute ( NewOwnerAgent, #ATTRIB_Armor_Struct_Bonus, $LWS_ArmorTierBaseBonus ( ItemTier ));
            // Northern Expansion treasure armor stores its persistent enchantment here.
            // Armor_Basic_Damage is engine-managed and can be recalculated after pickup.
            $SetAttribute ( NewOwnerAgent, #ATTRIB_Armor_Magic_Bonus, ItemAffix );
            $CreateEffector ( NewOwnerAgent, "got_armor", 0 );
            $DebugOut ( 911, "LWS EQUIPPED ARMOR", NewOwnerAgent, "TIER", ItemTier, "AFFIX", ItemAffix, "EFFECTIVE", ItemEffective );
        end

    $DeleteInventoryItem ( AttributeID, NewOwnerAgent );
End

////////////////////////////////////////////////////////////////////////////////////////////////////////
Function LWS_EquipWeaponTransfer ( agent OldOwnerAgent, agent NewOwnerAgent, integer AttributeID )
Declare
    integer ItemTier, ItemAffix, ItemEffective;
Begin
    if ( $IsValidGamePiece ( NewOwnerAgent ) == FALSE ) return;

    if ( $LWS_ShouldRetrieveWeapon ( NewOwnerAgent, OldOwnerAgent ))
        begin
            ItemTier = OldOwnerAgent's "LWS_EquipmentTier";
            ItemAffix = OldOwnerAgent's "LWS_EquipmentAffixBonus";
            ItemEffective = $LWS_WeaponEffectiveBonus ( ItemTier, ItemAffix );

            $LWS_EnsureWeaponEquipmentState ( NewOwnerAgent );
            NewOwnerAgent's "LWS_WeaponTier" = ItemTier;
            NewOwnerAgent's "LWS_WeaponAffixBonus" = ItemAffix;
            // Keep the native quality field pure so the UI name reflects only the tier.
            $SetAttribute ( NewOwnerAgent, #ATTRIB_Weapon_Struct_Bonus, $LWS_WeaponTierBaseBonus ( ItemTier ));
            // The affix augments native base damage and is therefore visible and combat-effective.
            $SetAttribute ( NewOwnerAgent, #ATTRIB_Weapon_Basic_Damage, NewOwnerAgent's "LWS_WeaponBaseDamage" + ItemAffix );
            $CreateEffector ( NewOwnerAgent, "got_weapon", 0 );
            $DebugOut ( 911, "LWS EQUIPPED WEAPON", NewOwnerAgent, "TIER", ItemTier, "AFFIX", ItemAffix, "EFFECTIVE", ItemEffective );
        end

    // The ground item is only a carrier for the equipped weapon state.
    $DeleteInventoryItem ( AttributeID, NewOwnerAgent );
End

